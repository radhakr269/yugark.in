# ==============================================================================
# YUGARK DIGITAL STUDIO — PRODUCTION ENVIRONMENT VARIABLES (VERCEL)
# Configure these in: Vercel -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. EMAIL AUTOMATION (Resend)
# ------------------------------------------------------------------------------
# Your production API key from resend.com/api-keys
RESEND_API_KEY=
# Verified sending domain address (e.g., 'YUGARK Digital Studio <business@yugark.in>')
EMAIL_FROM=
# Notification recipient for new lead alerts (default: business@yugark.in)
ADMIN_NOTIFICATION_EMAIL=business@yugark.in

# ------------------------------------------------------------------------------
# 3. WHATSAPP AUTOMATION (Interakt Official API)
# ------------------------------------------------------------------------------
# Your Interakt API key from: Interakt Dashboard -> Settings -> Developer Settings -> Secret Key
INTERAKT_API_KEY=
# Interakt Base API endpoint (default: https://api.interakt.ai)
INTERAKT_BASE_URL=https://api.interakt.ai

# ------------------------------------------------------------------------------
# 4. INTERNAL STUDIO ALERTS (Optional Telegram / Slack / Webhook)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
INTERNAL_LEAD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. ADMIN AUTHENTICATION & APP URL
# ------------------------------------------------------------------------------
ADMIN_EMAIL=business@yugark.in
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=
APP_URL=https://www.yugark.in

# ------------------------------------------------------------------------------
# 6. SYSTEM CAPABILITIES
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
